# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=bazzite-t740-e9173

# Make this the same as your github username/organisation
REPO_ORGANIZATION="Nanja-at-web"

IMAGE_DESC="Bazzite Steam Gaming Mode image for the HP t740 with AMD Radeon E9173"
IMAGE_KEYWORDS="bazzite,bootc,htpc,hp-t740,amd,e9173,polaris,gamescope"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/97833865?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
