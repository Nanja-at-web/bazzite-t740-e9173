#!/usr/bin/env python3
"""Request a Hybrid Focus state change."""

import json
import os
from pathlib import Path
import sys


SHARE = Path(
    os.environ.get(
        "BAZZITE_HYBRID_FOCUS_HOME",
        Path.home() / ".local/share/bazzite-hybrid-focus",
    )
)
sys.path.insert(0, str(SHARE / "src"))

from bazzite_hybrid_focus.client import request
from bazzite_hybrid_focus.protocol import COMMANDS


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) != 1 or argv[0] not in COMMANDS:
        print("usage: bazzite-hybrid-focusctl game|desktop|toggle|status", file=sys.stderr)
        return 2
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        print("XDG_RUNTIME_DIR is not set", file=sys.stderr)
        return 3
    try:
        response = request(
            Path(runtime) / "bazzite-hybrid-focus/control.sock", argv[0]
        )
    except OSError as error:
        print(f"Hybrid Focus service unavailable: {error}", file=sys.stderr)
        return 3
    print(json.dumps(response, ensure_ascii=False))
    return 0 if response.get("ok") else 2


if __name__ == "__main__":
    raise SystemExit(main())
